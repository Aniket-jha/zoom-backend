PORT=5050
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# General (OAuth) app
ZOOM_OAUTH_CLIENT_ID=
ZOOM_OAUTH_CLIENT_SECRET=
ZOOM_OAUTH_REDIRECT_URL=http://localhost:5050/oauth/callback

# Meeting SDK app
ZOOM_MEETING_SDK_KEY=
ZOOM_MEETING_SDK_SECRET=

# Optional: host user id or email (defaults to 'me')
ZOOM_API_HOST_USER=

# Firebase Admin (Realtime DB + Firestore)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Alternative to file path: inline JSON (single line) for the service account
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}
FIREBASE_DATABASE_URL=
